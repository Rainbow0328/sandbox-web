# Sandbox Explorer - Environment Configuration
# Generate secrets with:
#   openssl rand -hex 24   (admin token)
#   openssl rand -hex 32   (master key)

EXPLORER_ADMIN_TOKEN=change-me-to-a-random-hex-string
EXPLORER_MASTER_KEY=change-me-to-a-random-32-byte-hex-string
EXPLORER_PUBLIC_URL=http://localhost:8080

# ---- Server Ports ----
# Backend port (used by uvicorn in production and dev mode).
# Also controls the Docker container's internal port.
#   CLI:  python start.py --port 3000
#   Env:  EXPLORER_PORT=3000
EXPLORER_PORT=8080

# Backend bind address.
#   CLI:  python start.py --host 127.0.0.1
#   Env:  EXPLORER_HOST=127.0.0.1
EXPLORER_HOST=0.0.0.0

# Frontend dev server port (only used in --dev mode).
#   CLI:  python start.py --dev --frontend-port 3001
#   Env:  EXPLORER_FRONTEND_PORT=3001
EXPLORER_FRONTEND_PORT=5173

# Database (default: SQLite)
# EXPLORER_DATABASE_URL=sqlite+aiosqlite:///./data/explorer.db
# EXPLORER_DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/explorer

# CORS (comma-separated origins, empty = same-origin only)
# EXPLORER_CORS_ORIGINS=http://localhost:5173
