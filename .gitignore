# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
backend/.venv/
backend/.pytest_cache/
backend/.ruff_cache/

# Databases (runtime data, never commit)
backend/data/*.db
backend/data/*.db-*
data/

# Build artifacts
backend/dist/
dist/
build/

# Test virtual environments
test-venv/
test-pypi-venv/
*venv/

# Node
frontend/node_modules/
frontend/dist/
frontend/tsconfig.tsbuildinfo

# Built frontend (generated by hatch_build.py during wheel build)
backend/app/static/*
!backend/app/static/.gitkeep

# Environment (contains secrets, never commit)
.env
.env.*
!.env.example

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Personal / internal testing docs — keep locally, never push to GitHub
docs/BACKUP_TESTING.md
docs/LOCAL_TESTING.md
docs/OpenSandbox-*.md
